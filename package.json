{
  "name": "@zextras/carbonio-ui-sdk",
  "version": "0.0.0-semantically-released",
  "description": "Zextras Carbonio Web SDK",
  "main": "dist/index.js",
  "bin": {
    "sdk": "dist/index.js"
  },
  "scripts": {
    "build:scripts": "rm -rf dist && tsc -p tsconfig.json && mkdir -p dist/configs && cp scripts/configs/*.template scripts/configs/yap.json dist/configs/ && chmod +x dist/index.js",
    "type-check": "tsc --noEmit",
    "prepare": "pnpm run build:scripts",
    "prepack": "pnpm run build:scripts",
    "deploy": "pnpm pack && rm -rf $PKG_PATH/node_modules/@zextras/carbonio-ui-sdk/* && tar -xf zextras-carbonio-ui-sdk-$npm_package_version.tgz -C $PKG_PATH/node_modules/@zextras/carbonio-ui-sdk/ --strip-components 1",
    "packTo": "pnpm pack --pack-destination $PKG_PATH && cd $PKG_PATH && pnpm i ./zextras-carbonio-ui-sdk-$npm_package_version.tgz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zextras/carbonio-ui-sdk.git"
  },
  "engines": {
    "node": "v22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.11.0",
  "keywords": [
    "Zextras",
    "Carbonio",
    "SDK"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/Zextras/carbonio-ui-sdk#readme",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@babel/core": "7.13.0",
    "babel-loader": "9.2.1",
    "circular-dependency-plugin": "5.2.2",
    "copy-webpack-plugin": "13.0.1",
    "css-loader": "6.11.0",
    "handlebars": "4.7.9",
    "handlebars-loader": "1.7.3",
    "html-webpack-plugin": "5.6.6",
    "less": "4.6.4",
    "less-loader": "12.3.2",
    "mini-css-extract-plugin": "2.10.2",
    "node-http-proxy-json": "0.1.9",
    "path-browserify": "1.0.1",
    "postcss": "8.5.3",
    "postcss-loader": "8.2.1",
    "semver": "7.7.4",
    "webpack": "5.105.4",
    "webpack-bundle-analyzer": "4.10.2",
    "webpack-dev-server": "5.2.3",
    "yargs": "18.0.0",
    "@svgr/webpack": "5.0.0"
  },
  "devDependencies": {
    "@types/circular-dependency-plugin": "5.0.8",
    "@types/node": "22.15.30",
    "@types/semver": "7.7.1",
    "@types/webpack-bundle-analyzer": "4.7.0",
    "@types/yargs": "17.0.35",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "24.2.9",
    "standard-version": "9.5.0",
    "typescript": "5.9.3"
  }
}
